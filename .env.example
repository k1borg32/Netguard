# Copy to .env (never commit .env, it's in .gitignore).
POSTGRES_USER=netguard
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=netguard
DATABASE_URL=postgresql+psycopg://netguard:change-me-locally@127.0.0.1:5432/netguard

LOG_LEVEL=INFO

# Load generator for the performance tests (make perf overrides these)
LOAD_RATE=200
LOAD_DURATION_S=0
LOAD_SCENARIOS=normal,port_scan

# API (week 6)
JWT_SECRET=change-me-locally
