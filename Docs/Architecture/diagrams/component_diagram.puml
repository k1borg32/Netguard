
@startuml
title NetGuard - Component Architecture

left to right direction

skinparam componentStyle uml2
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam linetype polyline
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam nodesep 85
skinparam ranksep 110
skinparam Padding 12

' ============================
' Components
' ============================

component "PCAP\nImporter" as PCAP
component "Traffic\nSimulator" as SIM
component "Message\nBroker" as MQ
component "Flow\nProcessor" as FP
component "Detection\nEngine" as DE
component "Database" as DB
component "Management\nAPI" as BE
component "Monitoring\nDashboard" as UI

' ============================
' Packet publishing
' ============================

PCAP ..> MQ : publish packets
SIM ..> MQ : publish synthetic traffic

' ============================
' Traffic processing
' ============================

FP ..> MQ : consume packet events

' Provided + Required Interface
FP -ri0)- DE : Network Flows

' ============================
' Database communication
' ============================

FP ..> DB : WRITE flows

DE ..> DB : WRITE detections / alerts\nREAD configurations

BE ..> DB : READ monitoring data\nWRITE user actions

' ============================
' Frontend integration
' ============================

BE -ri0)- UI : REST API\nHTTP / JSON

' ============================
' Layout
' ============================

PCAP -[hidden]down- SIM

MQ -[hidden]right- FP
FP -[hidden]right- DE

DE -[hidden]down- DB

DB -[hidden]right- BE
BE -[hidden]right- UI

@enduml
