@startuml
title Authentication — component dependencies
left to right direction
skinparam componentStyle uml2
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam nodesep 35
skinparam ranksep 45

package "app/api" {
    component "Auth controller" as API
}
package "app/features/auth" {
    component "CQRS handlers" as Features
}
package "app/abstraction/auth" {
    interface "AuthRepository" as IRepo
    interface "PasswordHasher" as IHash
    interface "TokenIssuer" as ITokens
}
package "app/infrastructure" {
    component "PsycopgAuthRepository" as Repo
    component "Argon2PasswordHasher" as Hash
    component "AuthXTokenIssuer" as Tokens
}
component "Composition root\napp/di" as DI
database "TimescaleDB\nusers\nauth_refresh_sessions" as DB

API ..> Features : dispatches commands / queries
API ..> DI : resolves dependencies
Features ..> IRepo : uses
Features ..> IHash : uses
Features ..> ITokens : uses
Repo -- IRepo
Hash -- IHash
Tokens -- ITokens
DI ..> Features : constructs handlers
DI ..> Repo : binds
DI ..> Hash : binds
DI ..> Tokens : binds
Repo ..> DB : SQL via psycopg

legend bottom left
  Dashed arrows: dependencies.
  Circles with solid connections: provided UML interfaces.
endlegend
@enduml
