
@startuml
title NetGuard - Domain Model

left to right direction
skinparam linetype ortho
skinparam shadowing false
skinparam classAttributeIconSize 0

class "Network Flow" as Flow {
    Flow Identifier
    Source Address
    Destination Address
    Source Port
    Destination Port
    Protocol
    Start Time
    Duration
    Packet Count
    Byte Count
    Traffic Source
    Ground Truth Label
}

class "Detection" as Detection {
    Detection Identifier
    Anomaly Type
    Detection Method
    Severity
    Confidence
    Detection Time
    Analysis Window
    Features
    Explanation
}

class "Alert" as Alert {
    Alert Identifier
    Status
    Creation Time
    Acknowledgement Time
}

class "Detection Configuration" as Config {
    Detection Type
    Detection Method
    Parameters
    Active Status
}

class "User" as User {
    User Identifier
    Username
    Role
}

Flow "0..*" -- "0..*" Detection : contributes to
Detection "1" -- "0..1" Alert : generates
Config "1" -- "0..*" Detection : used by
User "0..1" -- "0..*" Alert : acknowledges
User "0..1" -- "0..*" Config : modifies

@enduml
