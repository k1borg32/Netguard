
@startuml
!pragma layout smetana
title Netguard - Component Diagram

skinparam componentStyle rectangle
skinparam shadowing false

package "Data Sources" {
    component "PCAP Importer" as PCAP
}

package "Message Infrastructure" {
    queue "Message Broker" as Broker
}

package "Traffic Analysis" {
    component "Flow Processor" as Flow
    component "Detection Engine" as Detection
}

package "Backend & Storage" {
    database "Database" as DB
    component "REST API" as API
}

package "Presentation" {
    component "Monitoring Dashboard" as Dashboard
}

PCAP --> Broker : Network flows

Broker --> Flow : Flow events

Flow --> Detection : Network flows
Flow --> DB : Persist flows

Detection --> DB : Persist anomalies / alerts

Dashboard --> API : HTTP / REST
API --> DB : Query flows / alerts / statistics
DB --> API : Query results
API --> Dashboard : JSON responses

@enduml
