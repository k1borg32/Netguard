
@startuml
title NetGuard - Database ERD

hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam entity {
    BackgroundColor #EAF2FF
    BorderColor #3666A3
}

entity "network_flows" as Flow {
    * flow_id : UUID <<PK>>
    * ts_start : TIMESTAMPTZ <<PK>>
    --
    trace_id : TEXT
    ingested_at : TIMESTAMPTZ
    duration_ms : DOUBLE PRECISION
    src_ip : INET
    dst_ip : INET
    src_port : INTEGER
    dst_port : INTEGER
    protocol : TEXT
    packets : BIGINT
    bytes : BIGINT
    tcp_flags : TEXT
    source : TEXT
}

entity "detection_flows" as DetectionFlow {
    * detection_id : UUID <<PK, FK>>
    * flow_id : UUID <<PK, FK>>
    * flow_ts_start : TIMESTAMPTZ <<PK, FK>>
}

entity "detections" as Detection {
    * detection_id : UUID <<PK>>
    --
    configuration_id : UUID <<FK>>
    created_at : TIMESTAMPTZ
    first_ingested_at : TIMESTAMPTZ
    type : TEXT
    method : TEXT
    severity : TEXT
    confidence : DOUBLE PRECISION
    src_ip : INET
    dst_ip : INET
    window_size_s : INTEGER
    window_start : TIMESTAMPTZ
    window_end : TIMESTAMPTZ
    features : JSONB
    explanation : TEXT
    trace_ids : TEXT[]
}

entity "alerts" as Alert {
    * alert_id : UUID <<PK>>
    --
    detection_id : UUID <<FK, UNIQUE>>
    status : TEXT
    created_at : TIMESTAMPTZ
    acknowledged_at : TIMESTAMPTZ
    acknowledged_by : UUID <<FK, NULL>>
}

entity "detection_configurations" as Config {
    * configuration_id : UUID <<PK>>
    --
    detection_type : TEXT
    detection_method : TEXT
    parameters : JSONB
    is_active : BOOLEAN
    modified_by : UUID <<FK, NULL>>
    created_at : TIMESTAMPTZ
}

entity "users" as User {
    * user_id : UUID <<PK>>
    --
    username : TEXT
    password_hash : TEXT
    role : TEXT
    created_at : TIMESTAMPTZ
    password_hash : TEXT

}

Flow ||--o{ DetectionFlow : contributes
Detection ||--o{ DetectionFlow : contains

Config ||--o{ Detection : configures
Detection ||--o| Alert : generates
User |o--o{ Alert : acknowledges
User |o--o{ Config : modifies



@enduml
