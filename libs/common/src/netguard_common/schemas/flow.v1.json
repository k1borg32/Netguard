{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "netguard/flow.v1",
  "title": "Normalised network flow (topic: flows.raw)",
  "type": "object",
  "required": [
    "schema_version", "flow_id", "trace_id", "ingested_at",
    "ts_start", "duration_ms", "src_ip", "dst_ip", "src_port", "dst_port",
    "protocol", "packets", "bytes", "source"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "flow_id":     { "type": "string", "format": "uuid", "description": "Unique per flow. Deterministic (uuid5) when imported from a file so replays dedupe." },
    "trace_id":    { "type": "string", "minLength": 8, "maxLength": 64, "description": "Correlation ID carried to every downstream event and log line (F15, NFR08)." },
    "ingested_at": { "type": "number", "description": "Unix epoch seconds (float) when NetGuard accepted the data. Basis of the latency measurement (NFR02)." },
    "ts_start":    { "type": "number", "description": "Unix epoch seconds (float) of first packet." },
    "duration_ms": { "type": "number", "minimum": 0 },
    "src_ip":      { "type": "string", "anyOf": [{ "format": "ipv4" }, { "format": "ipv6" }] },
    "dst_ip":      { "type": "string", "anyOf": [{ "format": "ipv4" }, { "format": "ipv6" }] },
    "src_port":    { "type": "integer", "minimum": 0, "maximum": 65535 },
    "dst_port":    { "type": "integer", "minimum": 0, "maximum": 65535 },
    "protocol":    { "enum": ["TCP", "UDP", "ICMP", "OTHER"] },
    "packets":     { "type": "integer", "minimum": 0 },
    "bytes":       { "type": "integer", "minimum": 0 },
    "tcp_flags":   { "type": ["string", "null"], "pattern": "^[FSRPAUEC]*$", "description": "e.g. 'S', 'SA', 'FA'. Null when not TCP / unknown." },
    "source":      { "enum": ["pcap", "flowfile", "simulator"] },
    "label":       { "type": ["string", "null"], "enum": [null, "normal", "port_scan", "dos", "brute_force", "abnormal_traffic", "suspicious_pattern"], "description": "Ground truth from simulator/labelled datasets. Used ONLY for metrics, never by detectors." }
  }
}
