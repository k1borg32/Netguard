{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "netguard/detection.v1",
  "title": "Detection result (topic: detections)",
  "type": "object",
  "required": [
    "schema_version", "detection_id", "trace_ids", "created_at", "first_ingested_at",
    "type", "method", "severity", "confidence", "src_ip", "dst_ip",
    "window", "features", "explanation"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version":    { "const": 1 },
    "detection_id":      { "type": "string", "format": "uuid", "description": "Deterministic uuid5(type|method|src|dst|window_start|window_size) so duplicates upsert (resilience)." },
    "trace_ids":         { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 50, "description": "Sample of trace_ids of flows that contributed (F15)." },
    "created_at":        { "type": "number", "description": "Epoch seconds when detection was created." },
    "first_ingested_at": { "type": "number", "description": "Earliest ingested_at of contributing flows. latency = created_at - first_ingested_at (NFR02)." },
    "type":              { "enum": ["port_scan", "dos", "brute_force", "abnormal_pattern"] },
    "method":            { "enum": ["rule", "statistical"] },
    "severity":          { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "confidence":        { "type": "number", "minimum": 0, "maximum": 1 },
    "src_ip":            { "type": ["string", "null"] },
    "dst_ip":            { "type": ["string", "null"] },
    "window": {
      "type": "object",
      "required": ["size_s", "start", "end"],
      "additionalProperties": false,
      "properties": {
        "size_s": { "enum": [1, 10, 60] },
        "start":  { "type": "number" },
        "end":    { "type": "number" }
      }
    },
    "features":    { "type": "object", "description": "Key feature values, e.g. {unique_dst_ports: 412, threshold: 100} (F09).", "additionalProperties": { "type": ["number", "string", "boolean"] } },
    "explanation": { "type": "string", "minLength": 1, "maxLength": 2000 }
  }
}
